# SPDX-License-Identifier: AGPL-3.0-only
#
# Wiki.js Psono Connector — sidecar configuration.
# Copy to connector.env next to your docker-compose.yml and edit.
# Full reference: docs/configuration.md
#
# ⚠️  HTTPS IS REQUIRED. All three public URLs below must start with https://.
#     Over plain HTTP, API keys, passwords, one-time codes and the Wiki.js
#     session travel in clear text.

# --- Required -----------------------------------------------------------------

# The wiki address exactly as users type it in the browser (scheme + host [+ port]).
PSONO_CONNECTOR_PUBLIC_URL=https://wiki.example.com

# Your Psono web client and its API (usually <web client>/server).
PSONO_WEB_BASE_URL=https://psono.example.com
PSONO_API_BASE_URL=https://psono.example.com/server

# Pin of the Psono server (required). Shown as "server signature" in Psono's
# API key dialog, or print it with:
#   docker run --rm -e PSONO_API_BASE_URL=https://psono.example.com/server IMAGE node main.cjs print-server-pin
# Compare the printed value with Psono before using it.
PSONO_SERVER_VERIFY_KEY=

# How the sidecar reaches Wiki.js directly (Docker service name + internal port).
WIKIJS_INTERNAL_URL=http://wikijs:3000

# Secrets as files (Docker secrets). Generate once:
#   umask 077; openssl rand -hex 32 > master.key      # back this up offline
PSONO_CONNECTOR_MASTER_KEY_FILE=/run/secrets/master_key
DATABASE_URL_FILE=/run/secrets/database_url

# --- Reverse proxy ------------------------------------------------------------
# Which proxies may report the real client IP. Pick ONE line, or leave all
# commented: the sidecar log then prints the exact value to put here.
#
# nginx/Apache on another machine (put that machine's IP):
#PSONO_CONNECTOR_TRUSTED_PROXIES=10.0.0.10
# Caddy/nginx/Traefik as a container on the same Docker host:
#PSONO_CONNECTOR_TRUSTED_PROXIES=uniquelocal
# Proxy on the same host using host networking:
#PSONO_CONNECTOR_TRUSTED_PROXIES=loopback

# --- Optional (defaults shown) --------------------------------------------------
#PSONO_CONNECTOR_ENABLED=true
#PSONO_CONNECTOR_DEVICE_TTL_DAYS=30            # 1–30: then users re-enter their key
#PSONO_CONNECTOR_PASSWORD_VISIBLE_SECONDS=30   # passwords and one-time codes auto-hide
#PSONO_CONNECTOR_LOAD_MODE=visible             # or "click"
#PSONO_CONNECTOR_REQUEST_TIMEOUT_MS=8000
#PSONO_CONNECTOR_LOG_LEVEL=info

# --- Development only — NEVER in production -------------------------------------
#PSONO_CONNECTOR_ALLOW_HTTP=true
