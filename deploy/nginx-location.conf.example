# SPDX-License-Identifier: AGPL-3.0-only
# Add inside the existing `server { ... }` block of your wiki (HTTPS) site.
# Replace 10.0.0.20:3100 with where the sidecar is reachable from nginx.
# See docs/deployment/reverse-proxy.md for the explanation and the checks.
location ^~ /psono-connector/ {
    proxy_pass http://10.0.0.20:3100;          # no trailing path: keep the prefix
    proxy_http_version 1.1;
    proxy_set_header Connection "";
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    client_max_body_size 16k;
    proxy_cache off;
}
